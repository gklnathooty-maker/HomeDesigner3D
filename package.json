{
  "name": "homedesigner3d",
  "version": "1.0.0",
  "description": "Turn a floor plan image into an editable 3D home: walls, doors, windows, furniture, paint, garden, walk-through",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/app.js --bundle --minify --outfile=src/app.bundle.js",
    "start": "npm run build && electron .",
    "test": "npm run build && xvfb-run -a electron --no-sandbox test/smoke.js",
    "dist": "npm run build && electron-builder --win",
    "pack": "npm run build && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "com.homedesigner3d.app",
    "productName": "HomeDesigner 3D",
    "files": [
      "main.js",
      "src/index.html",
      "src/app.bundle.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HomeDesigner-3D-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "author": "HomeDesigner 3D",
  "license": "MIT",
  "private": true
}